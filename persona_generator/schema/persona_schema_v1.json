{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PersonaSchemaMVP",
    "type": "object",
    "required": ["role", "tone", "traits", "dialogue_behavior"],
    "properties": {
      "name": {
        "type": "string",
        "description": "Optional character name"
      },
      "role": {
        "type": "string",
        "description": "Character's primary role, e.g., 'Teacher', 'CEO'"
      },
      "tone": {
        "type": "string", 
        "description": "Speech tone, e.g., 'formal', 'casual', 'friendly'"
      },
      "traits": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 2,
        "maxItems": 3,
        "description": "2-3 key personality traits"
      },
      "dialogue_behavior": {
        "type": "string",
        "description": "How the character speaks and interacts"
      },
      "quirks": {
        "type": "array",
        "items": { "type": "string" },
        "maxItems": 2,
        "description": "Optional quirks (max 2 for MVP)"
      }
    },
    "additionalProperties": false
  }
  