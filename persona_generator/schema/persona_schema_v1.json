{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PersonaSchemaMinimal",
  "type": "object",
  "required": ["role", "tone", "traits", "dialogue_behavior"],
  "properties": {
    "role": { "type": "string", "minLength": 1 },
    "tone": { "type": "string", "minLength": 1 },
    "traits": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dialogue_behavior": { "type": "string", "minLength": 1 },

    "name": { "type": "string" },
    "quirks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scenario_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "llm_prompt_injection": { "type": "string" },
    "id": { "type": "string" }
  },
  "additionalProperties": false
}
